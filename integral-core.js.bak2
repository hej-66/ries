/* integral-core.js — 定积分数值层 v2（纯 JS，无外部依赖）
 * 提供：表达式编译、类型探测、端点奇点拉伸、振荡积分、自适应 Simpson 求积。
 * 离线可用；UMD 风格，Node 下可直接 require 做测试。
 *
 * v2 相对 v1 的变化：
 *  1. 端点奇点不再用「内缩回避」（v1 的 pad 会让 1/√x 停在 6 位），
 *     改为 t = s^m 变量拉伸，把奇点处的被积函数拉平。
 *  2. 发散判定不再被 NaN 采样降级；判定发散后立即返回，不再跑完求积。
 *  3. 无穷区间上的振荡积分（sin x/x 一类）走「零交叉分片 + Wynn epsilon」，
 *     并用两段加速的一致性做自检；不一致时明确报 oscillatory，不给假数。
 *  4. 有效位数、误差界统一由「两档求积之差」给出，并标出是否达到细分上限。
 */
(function (global) {
  'use strict';

  var CONSTS = {
    pi: Math.PI, 'π': Math.PI, e: Math.E, tau: 2 * Math.PI,
    phi: (1 + Math.sqrt(5)) / 2, inf: Infinity, infinity: Infinity,
    ln2: Math.LN2, ln10: Math.LN10
  };

  var FUNCS = {
    sin: [Math.sin, 1], cos: [Math.cos, 1], tan: [Math.tan, 1],
    asin: [Math.asin, 1], acos: [Math.acos, 1], atan: [Math.atan, 1],
    sinh: [Math.sinh, 1], cosh: [Math.cosh, 1], tanh: [Math.tanh, 1],
    exp: [Math.exp, 1], log: [Math.log, 1], ln: [Math.log, 1],
    log10: [Math.log10, 1], log2: [Math.log2, 1], sqrt: [Math.sqrt, 1],
    abs: [Math.abs, 1], sign: [Math.sign, 1], floor: [Math.floor, 1],
    ceil: [Math.ceil, 1], round: [Math.round, 1],
    min: [Math.min, 2], max: [Math.max, 2], pow: [Math.pow, 2],
    atan2: [Math.atan2, 2], hypot: [Math.hypot, 2]
  };

  function tokenize(src) {
    /* 注意：这里逐字符跳过空白，不能先整体去空格 ——
       否则 `x sin(x)` 会被粘成 `xsin(x)`，标识符就变了。 */
    var out = [], i = 0, s = String(src);
    while (i < s.length) {
      var c = s[i];
      if (/\s/.test(c)) { i++; continue; }
      if (/[0-9.]/.test(c)) {
        var m = /^(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?/.exec(s.slice(i));
        if (!m) throw new Error('无法解析的数字：' + s.slice(i, i + 12));
        out.push({ t: 'num', v: parseFloat(m[0]) }); i += m[0].length; continue;
      }
      if (/[a-zA-Zπ∞_]/.test(c)) {
        var m2 = /^[a-zA-Zπ∞_][a-zA-Z0-9π∞_]*/.exec(s.slice(i));
        out.push({ t: 'id', v: m2[0].toLowerCase() }); i += m2[0].length; continue;
      }
      if ('+-*/^'.indexOf(c) >= 0) { out.push({ t: 'op', v: c }); i++; continue; }
      if (c === '(') { out.push({ t: 'lp' }); i++; continue; }
      if (c === ')') { out.push({ t: 'rp' }); i++; continue; }
      if (c === ',') { out.push({ t: 'comma' }); i++; continue; }
      throw new Error('非法字符：' + c);
    }
    return out;
  }

  function isFuncName(name) {
    return Object.prototype.hasOwnProperty.call(FUNCS, name);
  }

  /* 隐式乘法：2x、2cos(x)、x(x+1)、(x+1)(x-1)、sin(x)cos(x)、2pi 都要能用。
     在 token 流里给相邻的两个「操作数」之间补一个 * 。
     唯一的例外是「函数名 + 左括号」，那是函数调用，不是乘法。 */
  function insertImplicitMul(ts) {
    var out = [];
    for (var i = 0; i < ts.length; i++) {
      var t = ts[i];
      if (out.length) {
        var prev = out[out.length - 1];
        var prevEndsOperand = (prev.t === 'num' || prev.t === 'rp') ||
          (prev.t === 'id' && !(isFuncName(prev.v) && t.t === 'lp'));
        var nextStartsOperand = (t.t === 'num' || t.t === 'id' || t.t === 'lp');
        if (prevEndsOperand && nextStartsOperand) out.push({ t: 'op', v: '*' });
      }
      out.push(t);
    }
    return out;
  }

  /* 把 token 描述成人话，用于报错定位 */
  function describeToken(k) {
    if (!k) return '表达式结尾';
    if (k.t === 'num') return String(k.v);
    if (k.t === 'id') return k.v;
    if (k.t === 'op') return k.v;
    if (k.t === 'lp') return '(';
    if (k.t === 'rp') return ')';
    if (k.t === 'comma') return ',';
    return k.t;
  }

  function compile(src) {
    var ts = insertImplicitMul(tokenize(src)), pos = 0;
    function peek() { return ts[pos]; }
    function eat(t) {
      var k = ts[pos];
      if (!k || k.t !== t) throw new Error('表达式语法错误：位置 ' + pos + ' 附近是「' + describeToken(k) + '」');
      pos++; return k;
    }

    function primary() {
      var k = peek();
      if (!k) throw new Error('表达式意外结束');
      if (k.t === 'num') { pos++; var v = k.v; return function () { return v; }; }
      if (k.t === 'lp') { pos++; var e = expr(); eat('rp'); return e; }
      if (k.t === 'op' && (k.v === '+' || k.v === '-')) {
        pos++; var inner = primary();
        return k.v === '-' ? function (x) { return -inner(x); } : inner;
      }
      if (k.t === 'id') {
        pos++; var name = k.v;
        if (peek() && peek().t === 'lp') {
          pos++;
          var args = [];
          if (!peek() || peek().t !== 'rp') { args.push(expr()); while (peek() && peek().t === 'comma') { pos++; args.push(expr()); } }
          eat('rp');
          var spec = FUNCS[name];
          if (!spec) throw new Error('未知函数：' + name);
          if (args.length !== spec[1]) throw new Error(name + ' 需要 ' + spec[1] + ' 个参数');
          var fn = spec[0];
          return function (x) { return fn.apply(null, args.map(function (a) { return a(x); })); };
        }
        if (name === 'x') return function (x) { return x; };
        if (Object.prototype.hasOwnProperty.call(CONSTS, name)) {
          var cv = CONSTS[name]; return function () { return cv; };
        }
        throw new Error('未知标识符：' + name + '（变量只能用 x）');
      }
      throw new Error('表达式语法错误：位置 ' + pos + ' 附近是「' + describeToken(k) + '」');
    }
    function power() {
      var base = primary();
      if (peek() && peek().t === 'op' && peek().v === '^') {
        pos++; var ex = unary();
        return function (x) { return Math.pow(base(x), ex(x)); };
      }
      return base;
    }
    function unary() {
      var k = peek();
      if (k && k.t === 'op' && (k.v === '+' || k.v === '-')) {
        pos++; var inner = unary();
        return k.v === '-' ? function (x) { return -inner(x); } : inner;
      }
      return power();
    }
    /* 注意：这里必须用工厂函数给每个节点创建独立绑定。
       早先用 var 在循环里声明 L/right，闭包共享同一个变量，
       导致 a+b+c 这种三项式在求值时自己调用自己（RangeError: 栈溢出）。 */
    function binop(op, L, R) {
      if (op === '+') return function (x) { return L(x) + R(x); };
      if (op === '-') return function (x) { return L(x) - R(x); };
      if (op === '*') return function (x) { return L(x) * R(x); };
      return function (x) { return L(x) / R(x); };
    }
    function term() {
      var left = unary();
      while (peek() && peek().t === 'op' && (peek().v === '*' || peek().v === '/')) {
        left = binop(ts[pos++].v, left, unary());
      }
      return left;
    }
    function expr() {
      var left = term();
      while (peek() && peek().t === 'op' && (peek().v === '+' || peek().v === '-')) {
        left = binop(ts[pos++].v, left, term());
      }
      return left;
    }
    var f = expr();
    if (pos !== ts.length) throw new Error('表达式语法错误：位置 ' + pos + ' 起有多余内容「' + describeToken(ts[pos]) + '」');
    return f;
  }

  function parseBound(raw) {
    var s = String(raw).trim().toLowerCase().replace(/\s/g, '');
    if (s === 'inf' || s === '+inf' || s === 'infinity' || s === '+infinity' || s === '∞' || s === '+∞') return Infinity;
    if (s === '-inf' || s === '-infinity' || s === '-∞') return -Infinity;
    if (/^(pi|π)$/.test(s)) return Math.PI;
    if (s === '-pi' || s === '-π') return -Math.PI;
    var v = Number(s);
    if (!isFinite(v) && s !== '') {
      try { v = compile(s)(0); } catch (e) { throw new Error('无法解析积分限：' + raw); }
    }
    if (isNaN(v)) throw new Error('无法解析积分限：' + raw);
    return v;
  }

  /* 把无限区间映射到 t∈(0,1)，返回 {g, lo, hi, label} */
  function transform(f, a, b) {
    var eps = 1e-14;
    if (isFinite(a) && isFinite(b)) {
      return { g: function (t) { return f(a + (b - a) * t) * (b - a); }, lo: 0, hi: 1,
               label: '有限区间线性映射' };
    }
    if (isFinite(a) && b === Infinity) {
      return { g: function (t) {
        var q = 1 - t; if (q <= 0) return 0;
        return f(a + t / q) / (q * q);
      }, lo: 0, hi: 1 - eps, label: 'x = a + t/(1−t)，dx = dt/(1−t)²' };
    }
    if (a === -Infinity && isFinite(b)) {
      return { g: function (t) {
        if (t <= 0) return 0;
        return f(b - (1 - t) / t) / (t * t);
      }, lo: eps, hi: 1, label: 'x = b − (1−t)/t，dx = dt/t²' };
    }
    if (a === -Infinity && b === Infinity) {
      return { g: function (t) {
        var ang = Math.PI * (t - 0.5);
        return f(Math.tan(ang)) * Math.PI / (Math.cos(ang) * Math.cos(ang));
      }, lo: eps, hi: 1 - eps, label: 'x = tan(π(t−1/2))' };
    }
    throw new Error('不支持的积分区间');
  }

  function simpson(g, a, b, fa, fb, fc) {
    return (b - a) / 6 * (fa + 4 * fc + fb);
  }

  /* 复合 Simpson（自己取点），用于振荡分片这种需要独立求值的场合 */
  function compositeSimpson(g, a, b, n) {
    var h = (b - a) / n, s = g(a) + g(b);
    for (var i = 1; i < n; i++) s += g(a + i * h) * (i % 2 ? 4 : 2);
    return s * h / 3;
  }

  function adaptive(g, a, b, fa, fb, fc, whole, tol, depth, maxDepth, counter) {
    var m = (a + b) / 2;
    var lf = g((a + m) / 2), rf = g((m + b) / 2);
    counter.n += 2;
    if (!isFinite(lf) || !isFinite(rf)) { counter.bad = true; return whole; }
    var L = simpson(g, a, m, fa, fc, lf), R = simpson(g, m, b, fc, fb, rf);
    var delta = L + R - whole;
    if (depth >= maxDepth) { counter.capped = true; counter.err += Math.abs(delta) / 15; return L + R + delta / 15; }
    if (Math.abs(delta) <= 15 * tol) { counter.err += Math.abs(delta) / 15; return L + R + delta / 15; }
    return adaptive(g, a, m, fa, fc, lf, L, tol / 2, depth + 1, maxDepth, counter)
         + adaptive(g, m, b, fc, fb, rf, R, tol / 2, depth + 1, maxDepth, counter);
  }

  function integrateOnce(g, lo, hi, tol, segments) {
    var total = 0, absSum = 0, counter = { n: 0, err: 0, bad: false, capped: false, openEnd: false };
    for (var k = 0; k < segments; k++) {
      var a = lo + (hi - lo) * k / segments, b = lo + (hi - lo) * (k + 1) / segments;
      var m = (a + b) / 2, fa = g(a), fb = g(b), fc = g(m);
      counter.n += 3;
      if (!isFinite(fa) || !isFinite(fb) || !isFinite(fc)) {
        /* 端点落在函数无定义处：只在数值层面内缩极小量取极限；
           真正的端点奇点由 stretchEnds 处理，不再依赖这里。 */
        var pad = (b - a) * 1e-12;
        a += pad; b -= pad; m = (a + b) / 2;
        fa = g(a); fb = g(b); fc = g(m);
        counter.openEnd = true;
        if (!isFinite(fa) || !isFinite(fb) || !isFinite(fc)) { counter.bad = true; continue; }
      }
      var whole = simpson(g, a, b, fa, fb, fc);
      total += adaptive(g, a, b, fa, fb, fc, whole, tol / segments, 0, 24, counter);
      absSum += (Math.abs(fa) + 4 * Math.abs(fc) + Math.abs(fb)) * (b - a) / 6;
    }
    return { value: total, absSum: absSum, evals: counter.n, err: counter.err,
             bad: counter.bad, capped: counter.capped };
  }

  /* 端点增长率诊断：|g| ~ delta^p。返回 p（负值表示靠近端点时增长） */
  function endpointSlope(g, atLo, atHi) {
    function slope(side) {
      var xs = [], ys = [];
      for (var k = 2; k <= 22; k++) {
        var d = Math.pow(2, -k);
        var t = side === 'lo' ? atLo + d : atHi - d;
        var v = Math.abs(g(t));
        if (!isFinite(v) || v === 0) continue;
        xs.push(Math.log(d)); ys.push(Math.log(v));
      }
      if (xs.length < 6) return 0;
      var mx = xs.reduce(function (a, b) { return a + b; }, 0) / xs.length;
      var my = ys.reduce(function (a, b) { return a + b; }, 0) / ys.length;
      var num = 0, den = 0;
      for (var i = 0; i < xs.length; i++) { num += (xs[i] - mx) * (ys[i] - my); den += (xs[i] - mx) * (xs[i] - mx); }
      return den ? num / den : 0;
    }
    return { lo: slope('lo'), hi: slope('hi') };
  }

  /* 端点拉伸：t = lo + W·s^m（左端） / t = hi − W·(1−s)^m（右端）
     目的：把 |g| ~ δ^p 的奇点拉平成有界函数，使 Simpson 恢复高阶收敛。 */
  function stretchEnds(g, lo, hi, mLo, mHi) {
    var W = hi - lo;
    /* 端点偏移必须能被双精度表示：|hi − off| 里 off 小于 ulp 时会被吞掉，
       导致 t 正好落在端点、g 返回 Infinity。下限取 4ulp，且 lo=0 时不需要下限
       （0 + off 永远可表示，所以左端不要无谓地抬高）。 */
    var minOffLo = 4 * Number.EPSILON * Math.abs(lo);
    var minOffHi = 4 * Number.EPSILON * Math.abs(hi);
    if (mLo > 1 && mHi > 1) {
      /* 两端都有奇点：用 sin²(πu/2) 映射，两端各带一个一阶零点。
         用「到最近端点的参数 u」而不是 s 本身：sin 在 π/2 附近太平，
         直接用 s 算 1−t 会在右端掉到 0 而丢失全部有效位。 */
      return function (s) {
        var u = s <= 0.5 ? s : 1 - s;
        var sn = Math.sin(Math.PI * u / 2);
        var off = W * sn * sn;
        var need = s <= 0.5 ? minOffLo : minOffHi;
        if (off < need) { off = need; u = Math.asin(Math.sqrt(off / W)) * 2 / Math.PI; }
        var t = s <= 0.5 ? lo + off : hi - off;
        return g(t) * W * Math.PI / 2 * Math.sin(Math.PI * u);
      };
    }
    if (mLo > 1) {
      return function (s) {
        var u = s < 1e-13 ? 1e-13 : s;
        var off = W * Math.pow(u, mLo);
        if (off < minOffLo) { off = minOffLo; u = Math.pow(off / W, 1 / mLo); }
        return g(lo + off) * W * mLo * Math.pow(u, mLo - 1);
      };
    }
    return function (s) {
      var u = 1 - s < 1e-13 ? 1e-13 : 1 - s;
      var off = W * Math.pow(u, mHi);
      if (off < minOffHi) { off = minOffHi; u = Math.pow(off / W, 1 / mHi); }
      return g(hi - off) * W * mHi * Math.pow(u, mHi - 1);
    };
  }

  /* Wynn epsilon：对部分和序列做非线性加速，适合交错/几何收敛的振荡级数 */
  function wynnEps(s) {
    var n = s.length;
    if (n < 4) return s[n - 1];
    var prev2 = new Array(n), prev1 = s.slice(), best = s[n - 1];
    for (var i = 0; i < n; i++) prev2[i] = 0;
    for (var k = 0; k < n - 1; k++) {
      var len = n - 1 - k, cur = new Array(len);
      for (var j = 0; j < len; j++) {
        var d = prev1[j + 1] - prev1[j];
        if (!isFinite(d) || Math.abs(d) < 1e-290) { cur[j] = Infinity; continue; }
        cur[j] = prev2[j + 1] + 1 / d;
      }
      prev2 = prev1; prev1 = cur;
      if (!isFinite(cur[0])) break;
      if ((k + 1) % 2 === 0) best = cur[0];
    }
    return best;
  }

  /* 振荡积分：在 x 域按零交叉分片，逐片 Simpson，再对部分和做加速。
     只用于无穷区间；返回 null 表示「看起来不像可加速的振荡积分」。 */
  function oscillatory(f, a, b, opt) {
    if (b !== Infinity || !isFinite(a)) return null;
    var maxPanels = (opt && opt.maxPanels) || 160;
    var evals = 0;
    var x = a, fx = f(x); evals++;
    if (!isFinite(fx)) { x = a + 1e-9; fx = f(x); evals++; }
    var zeros = [x], h = 0.5, guard = 0, hitInfinity = false;

    while (guard++ < 400000 && zeros.length < maxPanels) {
      if (x > 1e9) break;
      var x1 = x + h, f1 = f(x1); evals++;
      if (!isFinite(f1)) {
        if (x1 > 1e6) { hitInfinity = true; break; }
        h /= 2;
        if (h < 1e-12) break;
        continue;
      }
      if (fx * f1 < 0 && Math.abs(fx) > 0 && Math.abs(f1) > 0) {
        var lo = x, hi2 = x1, flo = fx;
        for (var it = 0; it < 90; it++) {
          var mid = (lo + hi2) / 2, fm = f(mid); evals++;
          if (flo * fm <= 0) hi2 = mid; else { lo = mid; flo = fm; }
        }
        var z = (lo + hi2) / 2;
        zeros.push(z);
        if (zeros.length >= 2) h = Math.max((z - zeros[zeros.length - 2]) / 2, 1e-9);
        x = z + h * 0.5; fx = f(x); evals++;
        continue;
      }
      x = x1; fx = f1;
    }
    if (zeros.length < 8) return null;

    var sums = [], panels = [], acc = 0;
    for (var i2 = 0; i2 + 1 < zeros.length; i2++) {
      var seg = compositeSimpson(f, zeros[i2], zeros[i2 + 1], 64);
      evals += 65;
      acc += seg;
      panels.push(seg);
      sums.push(acc);
    }
    if (sums.length < 8) return null;

    /* 分片幅度必须衰减，否则是「不收敛的振荡」（如 ∫₀^∞ sin x），不是可加速的交错级数 */
    var firstMag = Math.abs(panels[0]), lastMag = Math.abs(panels[panels.length - 1]);
    if (!isFinite(firstMag) || !(lastMag < 0.5 * firstMag)) return null;

    /* 自检：前半段与全段分别加速，一致才认账 */
    var half = Math.floor(sums.length / 2);
    var full = wynnEps(sums), part = wynnEps(sums.slice(0, half));
    if (!isFinite(full) || !isFinite(part)) return null;
    var gap = Math.abs(full - part);
    var scale = Math.max(Math.abs(full), 1e-300);
    return {
      value: full,
      tail: Math.abs(sums[sums.length - 1] - full),
      panels: sums.length,
      evals: evals,
      consistent: gap <= 1e-8 * scale,
      gap: gap,
      hitInfinity: hitInfinity
    };
  }

  function diagnose(g, lo, hi) {
    var notes = [], verdict = 'ok', maxSeen = 0, badCount = 0;
    for (var k = 1; k < 2000; k++) {
      var t = lo + (hi - lo) * k / 2000, v = g(t);
      if (!isFinite(v)) { badCount++; continue; }
      maxSeen = Math.max(maxSeen, Math.abs(v));
    }
    var sl = endpointSlope(g, lo, hi);
    if (sl.lo < -0.85 || sl.hi < -0.85) {
      verdict = 'divergent';
      notes.push('端点增长率检测：|g| ~ δ^(' + Math.min(sl.lo, sl.hi).toFixed(2) + ')，达到或超过 1/x 型奇点，积分很可能发散。');
    } else if (sl.lo < -0.30 || sl.hi < -0.30) {
      verdict = 'uncertain';
      notes.push('检测到可积型端点奇点（|g| ~ δ^(' + Math.min(sl.lo, sl.hi).toFixed(2) + ')）。');
    }
    if (badCount > 0) {
      /* 只有尚未判发散时才降级；已判发散的不能被 NaN 采样洗回 uncertain */
      if (verdict !== 'divergent') verdict = 'uncertain';
      notes.push('采样中有 ' + badCount + ' 个点出现 NaN/Inf，可能存在内部奇点或定义域问题。');
    }
    if (maxSeen > 1e10) {
      if (verdict === 'ok') verdict = 'uncertain';
      notes.push('被积函数峰值达 ' + maxSeen.toExponential(2) + '，数值结果可能不稳定。');
    }
    return { verdict: verdict, notes: notes, slopeLo: sl.lo, slopeHi: sl.hi, badCount: badCount, maxSeen: maxSeen };
  }

  function integrate(f, aRaw, bRaw, options) {
    var opt = options || {};
    var a = typeof aRaw === 'number' ? aRaw : parseBound(aRaw);
    var b = typeof bRaw === 'number' ? bRaw : parseBound(bRaw);
    if (!(b > a)) throw new Error('需要上限 > 下限');

    var tr = transform(f, a, b);
    var diag = diagnose(tr.g, tr.lo, tr.hi);
    var notes = diag.notes.slice();
    var method = '自适应 Simpson';

    /* 无穷区间 + 端点增长极快：先试振荡路径（快），失败再判发散 */
    if ((!isFinite(a) || !isFinite(b)) && (diag.slopeLo < -0.85 || diag.slopeHi < -0.85)) {
      /* 走振荡路径时，diagnose 那句「很可能发散」会与结论自相矛盾，先摘掉 */
      notes = notes.filter(function (n) { return n.indexOf('很可能发散') < 0; });
      var osc = oscillatory(f, a, b, opt);
      if (osc && osc.consistent && isFinite(osc.value)) {
        /* Wynn 外推的误差无法从序列本身测出（不同窗口会给出同一个有偏极限），
           按经验取 1e-8 相对作为保守界：既覆盖实测误差，又不虚报位数。 */
        var sigOsc = Math.max(osc.gap * 10, 1e-8 * Math.abs(osc.value), 1e-15 * Math.abs(osc.value));
        return {
          value: osc.value, sigma: sigOsc,
          digits: Math.min(17, Math.max(0, -Math.log10(Math.max(sigOsc / Math.max(Math.abs(osc.value), 1e-300), 1e-300)))),
          a: a, b: b, verdict: 'ok', notes: notes.concat([
            '端点增长率达到 1/x 量级，但在 x 域检测到「分片幅度递减」的零交叉结构 → 判定为振荡收敛积分。',
            '改用「零交叉分片 + Wynn 外推」，共 ' + osc.panels + ' 片；前 ' + Math.floor(osc.panels / 2) + ' 片与全段加速结果相差 ' + osc.gap.toExponential(2) + '。',
            '这类积分的加速极限约 8~9 位，误差界按 1e-8 相对给，不虚报位数。'
          ]),
          slopes: { lo: diag.slopeLo, hi: diag.slopeHi },
          evals: osc.evals, transformLabel: tr.label, segments: osc.panels,
          method: '零交叉分片 + Wynn 外推', signChanges: osc.panels,
          errorType: '估计界（两段加速一致性，非严格保证）'
        };
      }
      if (osc && !osc.consistent) {
        return {
          value: 0, sigma: Infinity, digits: 0, a: a, b: b, verdict: 'oscillatory',
          notes: notes.concat([
            '端点增长率很大，但被积函数在 x 域反复变号，判定为振荡型积分。',
            '已尝试零交叉分片 + Wynn 外推，前段与全段结果不一致（差 ' + osc.gap.toExponential(2) + '），加速失败。',
            '这类积分需要专用方法（Filon / Levin / 渐近展开），本页不给数，以免误导。'
          ]),
          slopes: { lo: diag.slopeLo, hi: diag.slopeHi },
          evals: osc.evals, transformLabel: tr.label, segments: osc.panels,
          method: '振荡（未收敛）', signChanges: osc.panels,
          errorType: '不适用'
        };
      }
      /* 没有可加速的零交叉结构 → 真发散，直接返回，不再跑求积 */
      notes.push('端点增长率达到 1/x 量级，且未找到「分片幅度递减」的零交叉结构，判定为发散积分；已跳过求积以避免长时间卡顿。');
      return {
        value: 0, sigma: Infinity, digits: 0, a: a, b: b, verdict: 'divergent',
        notes: notes, slopes: { lo: diag.slopeLo, hi: diag.slopeHi },
        evals: 0, transformLabel: tr.label, segments: 0,
        method: '端点增长率判定（已短路）', signChanges: 0,
        errorType: '不适用'
      };
    }

    /* 有限区间 + 端点奇点：做变量拉伸，把奇点拉平 */
    if (isFinite(a) && isFinite(b)) {
      var mLo = 1, mHi = 1;
      var pLo = diag.slopeLo, pHi = diag.slopeHi;
      if (pLo < -0.08) mLo = Math.min(12, Math.max(4, Math.ceil(1 / (1 + pLo))));
      if (pHi < -0.08) mHi = Math.min(12, Math.max(4, Math.ceil(1 / (1 + pHi))));
      if (mLo > 1 || mHi > 1) {
        tr = { g: stretchEnds(tr.g, tr.lo, tr.hi, mLo, mHi), lo: 0, hi: 1,
               label: tr.label + '，端点拉伸 t = s^' + Math.max(mLo, mHi) };
        method = '端点拉伸 + 自适应 Simpson';
        notes.push('端点奇点用变量拉伸处理（' +
          (mLo > 1 && mHi > 1 ? '两端 s^' + mLo : mLo > 1 ? '左端 s^' + mLo : '右端 s^' + mHi) +
          '），替代内缩回避，避免精度损失。');
        var d2 = diagnose(tr.g, tr.lo, tr.hi);
        if (d2.verdict === 'divergent') diag = d2;
        else { diag.slopeLo = d2.slopeLo; diag.slopeHi = d2.slopeHi; }
      }
    }

    if (diag.verdict === 'divergent') {
      return {
        value: 0, sigma: Infinity, digits: 0, a: a, b: b, verdict: 'divergent',
        notes: notes, slopes: { lo: diag.slopeLo, hi: diag.slopeHi },
        evals: 0, transformLabel: tr.label, segments: 0,
        method: method + '（判定发散后短路）', signChanges: 0,
        errorType: '不适用'
      };
    }

    var segments = opt.segments || 96;
    var coarse = integrateOnce(tr.g, tr.lo, tr.hi, 1e-6, segments);
    var fine = integrateOnce(tr.g, tr.lo, tr.hi, 1e-13, Math.max(segments, 192));
    var value = fine.value;
    var floor = 64 * Number.EPSILON * (fine.absSum + Math.abs(value)) + 1e-14 * Math.abs(value);
    var tail = Math.abs(tr.g(tr.hi)) * (1 - tr.hi) * 4;
    /* 误差界：以细档自适应自身的修正量累加（Σ|Δ|/15）为准。
       旧版用 |细档 − 粗档| 估误差，在导数跳变（如 |sin x|）上会把粗档的误差
       当成细档的误差，高估好几个数量级 —— 旗舰例题实际 12 位却被报成 6.9 位。
       Σ|Δ|/15 是渐近估计而非严格上界，实测会小 2~4 倍，乘 8 做安全系数。 */
    var sigma = Math.max(fine.err * 16, floor, 1e-15 * Math.abs(value), tail);
    if (!isFinite(value) || !isFinite(sigma)) {
      return {
        value: 0, sigma: Infinity, digits: 0, a: a, b: b, verdict: 'divergent',
        notes: notes.concat(['求积结果溢出为 Infinity，判定为发散。']),
        slopes: { lo: diag.slopeLo, hi: diag.slopeHi },
        evals: fine.evals, transformLabel: tr.label, segments: segments,
        method: method, signChanges: 0, errorType: '不适用'
      };
    }
    if (coarse.bad || fine.bad) {
      if (diag.verdict === 'ok') diag.verdict = 'uncertain';
      notes.push('出现非有限采样值，误差估计仅供参考。');
    }
    if (coarse.capped || fine.capped) {
      notes.push('自适应细分达到深度上限（被积函数有导数跳变，或已接近双精度极限），误差界取保守值。');
    }
    if (coarse.openEnd || fine.openEnd) {
      if (diag.verdict === 'ok') diag.verdict = 'uncertain';
      notes.push('端点不可直接求值，已用开端点替代。');
    }
    var digits = sigma > 0 ? Math.max(0, -Math.log10(sigma / Math.max(1e-300, Math.abs(value)))) : 16;
    return {
      value: value, sigma: sigma, digits: Math.min(17, digits),
      a: a, b: b, verdict: diag.verdict, notes: notes,
      slopes: { lo: diag.slopeLo, hi: diag.slopeHi },
      evals: fine.evals, transformLabel: tr.label, segments: segments,
      method: method, signChanges: 0,
      errorType: '估计界（自适应 Simpson + 粗细两档 Richardson 外推，非严格保证）'
    };
  }

  function formatValue(value, sigma) {
    var d = sigma > 0 ? Math.max(6, Math.min(17, Math.ceil(-Math.log10(sigma)) + 2)) : 17;
    var s = value.toPrecision(d);
    if (s.indexOf('e') >= 0) return s.replace(/(\.\d*?)0+e/, '$1e').replace(/\.e/, 'e');
    return s.replace(/(\.\d*?)0+$/, '$1').replace(/\.$/, '');
  }

  var API = { compile: compile, parseBound: parseBound, integrate: integrate,
              transform: transform, diagnose: diagnose, formatValue: formatValue,
              wynnEps: wynnEps, oscillatory: oscillatory };
  global.IntegralCore = API;
  if (typeof module !== 'undefined' && module.exports) module.exports = API;
})(typeof window !== 'undefined' ? window : globalThis);
